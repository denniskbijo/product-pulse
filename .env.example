EASYPARSER_API_KEY=
# Local default: SQLite. On Vercel, use a hosted Postgres URL (Neon/Supabase/Vercel Postgres).
DATABASE_URL=sqlite:///./amazon_pulse.db
# DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require
# Optional: production Neon URL for `make db-pull` (otherwise pulled via Vercel CLI).
# PROD_DATABASE_URL=postgresql+psycopg://USER:PASS@HOST/DB?sslmode=require

MONTHLY_CREDIT_BUDGET=100
SYNC_TOP_N=10
# Seasonal Hunt candidates per run (Oxylabs only; no Easyparser credits).
HUNT_TOP_N=5
# Oxylabs Web Scraper API — required for Seasonal Hunt (1 request per run).
# https://developers.oxylabs.io/products/web-scraper-api
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
OXYLABS_BASE_URL=https://realtime.oxylabs.io/v1/queries
OXYLABS_STATS_URL=https://data.oxylabs.io/v2/stats
# Hard monthly budget for hunt gating (reserved before each Oxylabs call).
OXYLABS_MONTHLY_CREDIT_BUDGET=1000
OXYLABS_AMAZON_DOMAIN=co.uk
# Daily Amazon mobile price scrape (make scrape-prices / Vercel Cron). No Easyparser credits.
DAILY_SCRAPE_MAX=10
DAILY_SCRAPE_DELAY_SECONDS=1.5
# Required for /cron/* endpoints. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Explicit CORS allowlist (never use *).
# Local: http://localhost:3000
# Prod example: https://product-pulse-six.vercel.app,http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth (required). Use bcrypt hashes — never store plaintext passwords.
# Generate: cd apps/api && .venv/bin/python -c "from app.passwords import hash_password; print(hash_password('your-password'))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
USER_USERNAME=basil
USER_PASSWORD_HASH=
